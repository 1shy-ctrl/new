NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "anon" key (or the newer "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Student IDs are mapped to <id>@<this domain> for Supabase Auth.
# Use a domain you control. No email is ever sent (confirmations must be OFF).
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=cictboard.app
